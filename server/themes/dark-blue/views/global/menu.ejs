<% if (login) { %>
<div class="modal fade" id="newUserWelcomeModal" tabindex="-1" role="dialog" aria-labelledby="newUserWelcomeTitle" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog" role="document"><div class="modal-content whats-new-modal welcome-modal">
    <div class="modal-header"><h4 class="modal-title" id="newUserWelcomeTitle"><i class="fa fa-hand-paper-o"></i> <%= newUserWelcomeTitle %></h4></div>
    <div class="modal-body">
      <p><%= newUserWelcomeContent %></p>
      <div class="alert alert-danger welcome-safety"><strong><i class="fa fa-exclamation-triangle"></i> Important safety notice</strong><br>This service is supplementary only. Do not use it as your primary source for emergency information or to make safety, operational or deployment decisions. Information may be delayed, incomplete or inaccurate. Always confirm conditions with official emergency services and follow their directions.</div>
      <h5><strong><i class="fa fa-mobile"></i> Install the app</strong></h5>
      <p>Add this site to your Home Screen for quicker access and to enable supported push notifications.</p>
      <p><a class="btn btn-default" href="/pwa-help"><i class="fa fa-book"></i> iPhone &amp; Android setup instructions</a></p>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-primary" id="acknowledgeWelcome">I understand</button></div>
  </div></div>
</div>
<script>
$(function () {
  var showWelcome = <%- JSON.stringify(newUserWelcomeEnabled && !user.welcome_acknowledged && !suppressAutomaticModals) %>;
  if (showWelcome) $('#newUserWelcomeModal').modal('show');
  $('#acknowledgeWelcome').on('click', function () {
    var button = $(this).prop('disabled', true);
    $.post('/welcome/acknowledge').done(function () {
      $('#newUserWelcomeModal').modal('hide');
      $('#newUserWelcomeModal').data('welcomeAcknowledged', true);
    }).fail(function () {
      button.prop('disabled', false);
      window.alert('The acknowledgement could not be saved. Please try again.');
    });
  });
});
</script>
<% } %>

<% if (login && whatsNewEnabled && whatsNew && whatsNew.version) { %>
<div class="modal fade" id="whatsNewModal" tabindex="-1" role="dialog" aria-labelledby="whatsNewTitle">
  <div class="modal-dialog" role="document"><div class="modal-content whats-new-modal">
    <div class="modal-header"><button type="button" class="close" data-dismiss="modal" aria-label="Close">&times;</button><h4 class="modal-title" id="whatsNewTitle"><i class="fa fa-bullhorn"></i> What’s new in <%= monitorName || 'PagerMon' %></h4></div>
    <div class="modal-body"><p>PagerMon has been updated.</p><ul><% whatsNew.changes.forEach(function(change) { %><li><%= change %></li><% }); %></ul></div>
    <div class="modal-footer"><button type="button" class="btn btn-primary" data-dismiss="modal">Got it</button></div>
  </div></div>
</div>
<script>
$(function () {
  var key = 'pagermon-whats-new:' + <%- JSON.stringify(String(user.id || user.username || 'user')) %>;
  var version = <%- JSON.stringify(String(whatsNew.version)) %>;
  var showWhatsNew = function () { if (window.localStorage && localStorage.getItem(key) !== version) $('#whatsNewModal').modal('show'); };
  if (<%- JSON.stringify(suppressAutomaticModals) %>) return;
  if (<%- JSON.stringify(newUserWelcomeEnabled && !user.welcome_acknowledged) %>) $('#newUserWelcomeModal').one('hidden.bs.modal', showWhatsNew);
  else showWhatsNew();
  $('#whatsNewModal').on('hidden.bs.modal', function () { if (window.localStorage) localStorage.setItem(key, version); });
});
</script>
<% } %>

<script>
    $(function () {
        $("#home-body a:contains('Home')").parent().addClass('active');
        $("#admin-body a:contains('Admin')").parent().addClass('active');
     });
</script>

