<!DOCTYPE html>
<html lang="en">
<%- include('global/header.ejs') %>
</head>
<body id="status-body">
<%- include('global/menu.ejs') %>
<div id="content" class="container-fluid">
  <main class="cw-status-page">
    <div class="cw-status-heading">
      <h2><i class="fa fa-heartbeat"></i> Service Status</h2>
      <p>Private receiver health for Central West Alerts. Status updates automatically every 30 seconds.</p>
    </div>
    <div id="receiver-status" class="cw-status-grid">
      <div class="cw-status-card"><span class="cw-health-dot"></span><div><h3>Checking receivers…</h3><p>Please wait</p></div></div>
    </div>
    <div id="server-status" class="cw-status-meta">Checking PageMon server…</div>
  </main>
</div>
<script>
(function () {
  function escapeHtml(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, function (character) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character];
    });
  }
  function ageLabel(seconds) {
    if (seconds == null) return 'Never reported';
    seconds = Math.max(0, Number(seconds));
    if (seconds < 60) return Math.floor(seconds) + ' sec ago';
    if (seconds < 3600) return Math.floor(seconds / 60) + ' min ago';
    return Math.floor(seconds / 3600) + ' hr ago';
  }
  function uptimeLabel(seconds) {
    seconds = Math.max(0, Number(seconds) || 0);
    var days = Math.floor(seconds / 86400);
    var hours = Math.floor((seconds % 86400) / 3600);
    return (days ? days + 'd ' : '') + hours + 'h';
  }
  function memoryLabel(bytes) { return bytes ? Math.round(Number(bytes) / 1048576) + ' MB' : 'Unavailable'; }
  function refresh() {
    fetch('/api/central-west/receiver-status', {credentials: 'same-origin', cache: 'no-store'})
      .then(function (response) { if (!response.ok) throw new Error('HTTP ' + response.status); return response.json(); })
      .then(function (data) {
        var receivers = data.receivers || [];
        var local = data.local || {label: 'PagerMon', state: 'online'};
        var localCard = '<article class="cw-status-card cw-health-online"><span class="cw-health-dot"></span><div><h3>' + escapeHtml(local.label) + '</h3><p>Local PagerMon server · ' + escapeHtml(local.platform || '') + ' · ' + escapeHtml(local.nodeVersion || '') + '</p><p><strong>Receivers:</strong> ' + Number(local.onlineReceiverCount || 0) + ' online / ' + Number(local.receiverCount || 0) + ' configured</p><p><strong>PagerMon memory:</strong> ' + memoryLabel(local.memoryUsed) + '</p></div><div class="cw-status-value"><strong>Online</strong><span>Uptime ' + uptimeLabel(data.uptime) + '</span></div></article>';
        document.getElementById('receiver-status').innerHTML = localCard + receivers.map(function (receiver) {
          var state = receiver.state || 'offline';
          var label = state === 'online' ? 'Online' : state === 'stale' ? 'Beacon delayed' : 'Offline';
          return '<article class="cw-status-card cw-health-' + escapeHtml(state) + '">' +
            '<span class="cw-health-dot"></span><div><h3>' + escapeHtml(receiver.label) + '</h3>' +
            '<p>' + escapeHtml(receiver.location) + ' · ' + escapeHtml(receiver.frequency) + '</p>' +
            '<p><strong>Internal IP:</strong> ' + escapeHtml(receiver.internalIp || 'Awaiting receiver report') + '</p>' +
            '<p><strong>External IP:</strong> ' + escapeHtml(receiver.externalIp || 'Awaiting receiver report') + '</p>' +
            '<p><strong>Node:</strong> ' + escapeHtml(receiver.nodeName || 'Awaiting receiver report') + ' · ' + escapeHtml(receiver.platform || '') + '</p>' +
            '<p><strong>Node health:</strong> uptime ' + uptimeLabel(receiver.nodeUptime) + ' · load ' + escapeHtml(receiver.loadAverage == null ? '—' : receiver.loadAverage) + ' · memory ' + memoryLabel(receiver.totalMemory && receiver.freeMemory != null ? receiver.totalMemory - receiver.freeMemory : 0) + ' / ' + memoryLabel(receiver.totalMemory) + '</p></div>' +
            '<div class="cw-status-value"><strong>' + label + '</strong><span>Last check-in ' + ageLabel(receiver.age) + '</span></div></article>';
        }).join('');
        document.getElementById('server-status').innerHTML = '<strong>PageMon server online</strong> · Uptime ' + uptimeLabel(data.uptime) + ' · Last refreshed ' + new Date().toLocaleTimeString();
      })
      .catch(function () {
        document.getElementById('receiver-status').innerHTML = '<div class="alert alert-danger">Unable to retrieve receiver status.</div>';
        document.getElementById('server-status').textContent = 'PageMon status API unavailable';
      });
  }
  refresh();
  window.setInterval(refresh, 30000);
}());
</script>
<%- include('global/footer.ejs') %>
